node_modules/
dist/
*.zip
*.tar.gz
.pro-fetch-cache/
coverage/

# Secrets — never commit these, in any form.
# `.env` holds real local API keys on developer machines and is excluded from every commit.
# Ship `.env.example` (empty values) instead. `<NAME>_FILE` pointers are supported for
# credentials you prefer to keep outside the project folder entirely.
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Machine-specific MCP client config (contains absolute paths and host PATH).
# Commit `mcp.example.json` instead and copy it locally.
mcp.json
qwen-mcp.json

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and scratch output
*.log
npm-debug.log*
.npm/
.pro-fetch-cache/

# Test fixtures written by the credential tests
.pro-fetch-test-*.txt
.github-token-test-fixture.txt
# Session scratch scripts. The probes used to answer a question during development 
# (coverage sweeps, decoder fuzzing, protocol probes) are written into the repo root and 
# would otherwise be committed. They are not part of the package.
.*-tmp.mts
.*-tmp.mjs
.case*.mts
.list-tools.mts

# Tesseract language data (installed by npm, not committed)
eng.traineddata

# README render preview (build artefact, regenerated by scripts/preview-readme.mts)
.preview/
