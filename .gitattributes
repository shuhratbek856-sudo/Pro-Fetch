# Normalize line endings so every platform checks out LF.
# Prettier is configured with "endOfLine": "lf"; without this, Windows CI runners
# (actions/checkout sets core.autocrlf=true) check files out as CRLF and
# `npm run format:check` fails there while passing on Linux/macOS.
* text=auto eol=lf

# Never rewrite line endings inside binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
